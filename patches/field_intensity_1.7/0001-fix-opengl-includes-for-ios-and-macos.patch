From 652569580da86018431d7b107849ba839540e83f Mon Sep 17 00:00:00 2001
From: ksagameng <fordealisbad@gmail.com>
Date: Wed, 4 Mar 2026 14:07:12 +0300
Subject: [PATCH] FIx OpenGL includes for iOS and MacOS

---
 CMakeLists.txt                  |  4 ++++
 cl_dll/gl_dynamic.h             |  7 ++++++-
 cl_dll/particleman/CFrustum.cpp | 10 ++++++++++
 3 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index b12567af8c..ebc227a84c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -157,6 +157,10 @@ if(${CMAKE_SYSTEM_NAME} STREQUAL "Android")
 	endif()
 endif()
 
+if(${CMAKE_SYSTEM_NAME} STREQUAL "iOS" OR ${CMAKE_SYSTEM_NAME} STREQUAL "Darwin")
+	set(CMAKE_CXX_STANDARD 14)
+endif()
+
 # Xash3D FWGS Library Naming Scheme compliance
 # see documentation: https://github.com/FWGS/xash3d-fwgs/blob/master/Documentation/extensions/library-naming.md
 include(LibraryNaming)
diff --git a/cl_dll/gl_dynamic.h b/cl_dll/gl_dynamic.h
index a433529bea..4d50962f80 100644
--- a/cl_dll/gl_dynamic.h
+++ b/cl_dll/gl_dynamic.h
@@ -19,10 +19,15 @@
 #endif // _WIN32
 
 #ifdef __APPLE__
+#include <TargetConditionals.h>
+#if TARGET_OS_IOS
+#include <OpenGLES/ES1/gl.h>
+#else
 #include <OpenGL/gl.h>
+#endif //TARGET_OS_IOS
 #else
 #include <GL/gl.h>
-#endif
+#endif //__APPLE__
 
 typedef void (APIENTRY *GLAPI_glFogi)(GLenum pname, GLint param);
 
diff --git a/cl_dll/particleman/CFrustum.cpp b/cl_dll/particleman/CFrustum.cpp
index 9827bc991e..0db418d32a 100644
--- a/cl_dll/particleman/CFrustum.cpp
+++ b/cl_dll/particleman/CFrustum.cpp
@@ -15,7 +15,17 @@
 
 //The triangle API uses OpenGL constants for certain functions.
 #include "windows_lean.h"
+
+#ifdef __APPLE__
+#include <TargetConditionals.h>
+#if TARGET_OS_IOS
+#include <OpenGLES/ES1/gl.h>
+#else
+#include <OpenGL/gl.h>
+#endif //TARGET_OS_IOS
+#else
 #include <GL/gl.h>
+#endif //__APPLE__
 
 #include "cl_util.h"
 #include "triangleapi.h"
